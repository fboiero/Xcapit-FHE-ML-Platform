# Xcapit FHE-ML Platform - Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control

# =============================================================================
# REQUIRED - Django Core
# =============================================================================

# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-key-here-min-50-chars

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,apifhe.xcapit.com

# =============================================================================
# REQUIRED - Database (PostgreSQL)
# =============================================================================

# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://xcapit:strong-password-here@postgres:5432/fheml

# =============================================================================
# REQUIRED - Redis (Cache & Celery)
# =============================================================================

REDIS_URL=redis://redis:6379/0

# =============================================================================
# SECURITY - CORS & CSRF
# =============================================================================

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=https://xcapit-privacy.vercel.app,https://app.xcapit.io

# Comma-separated list of trusted CSRF origins
CSRF_TRUSTED_ORIGINS=https://apifhe.xcapit.com

# =============================================================================
# OPTIONAL - JWT (defaults to DJANGO_SECRET_KEY if not set)
# =============================================================================

# Separate signing key for JWT tokens (recommended for production)
# JWT_SIGNING_KEY=your-jwt-signing-key-here

# =============================================================================
# OPTIONAL - Monitoring
# =============================================================================

# Sentry DSN for error tracking
# SENTRY_DSN=https://xxx@sentry.io/xxx

# =============================================================================
# OPTIONAL - FHE Configuration
# =============================================================================

# Security level: 128, 192, or 256
FHE_SECURITY_LEVEL=128

# =============================================================================
# OPTIONAL - Email (for admin notifications)
# =============================================================================

# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True

# =============================================================================
# DOCKER - Container specific
# =============================================================================

# Run migrations on startup
RUN_MIGRATIONS=true

# Create superuser (initial setup only)
# DJANGO_SUPERUSER_EMAIL=admin@xcapit.com
# DJANGO_SUPERUSER_PASSWORD=change-this-password
