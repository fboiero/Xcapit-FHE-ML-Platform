[1.526, "o", "\u001b[3m         📊 Dataset de FinBank          \u001b[0m\r\n╭───────────────────────────┬──────────╮\r\n│\u001b[1m \u001b[0m\u001b[1mMétrica                  \u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1mValor   \u001b[0m\u001b[1m \u001b[0m│\r\n├───────────────────────────┼──────────┤\r\n│\u001b[36m \u001b[0m\u001b[36mTotal registros          \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m25      \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mClientes alto riesgo     \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m8 (32%) \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mClientes bajo riesgo     \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m17 (68%)\u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mIngreso promedio         \u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m$76,400 \u001b[0m\u001b[32m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mScore crediticio promedio\u001b[0m\u001b[36m \u001b[0m│\u001b[32m \u001b[0m\u001b[32m700     \u001b[0m\u001b[32m \u001b[0m│\r\n╰───────────────────────────┴──────────╯\r"]
[0.000, "o", "\r\n"]
