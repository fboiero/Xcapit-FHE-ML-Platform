[0.002, "o", "\u001b[3m     👤 Datos del Cliente     \u001b[0m\r\n\u001b[3m          (Cifrados)          \u001b[0m\r\n╭──────────────────┬─────────╮\r\n│\u001b[1m \u001b[0m\u001b[1mCampo           \u001b[0m\u001b[1m \u001b[0m│\u001b[1m \u001b[0m\u001b[1mValor  \u001b[0m\u001b[1m \u001b[0m│\r\n├──────────────────┼─────────┤\r\n│\u001b[36m \u001b[0m\u001b[36mEdad            \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m35 años\u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mIngreso         \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m$65,000\u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mRatio deuda     \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m35%    \u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mScore crediticio\u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m680    \u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mAños empleado   \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m6      \u001b[0m\u001b[37m \u001b[0m│\r\n│\u001b[36m \u001b[0m\u001b[36mMonto préstamo  \u001b[0m\u001b[36m \u001b[0m│\u001b[37m \u001b[0m\u001b[37m$20,000\u001b[0m\u001b[37m \u001b[0m│\r\n╰──────────────────┴─────────╯\r\n"]
