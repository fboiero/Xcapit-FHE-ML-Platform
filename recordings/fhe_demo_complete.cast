[0.001, "o", "\u001b[32m╭─\u001b[0m\u001b[32m───────────────────────────────\u001b[0m\u001b[32m 🎯 Resultado \u001b[0m\u001b[32m───────────────────────────────\u001b[0m\u001b[32m─╮\u001b[0m\r\n\u001b[32m│\u001b[0m\u001b[32m \u001b[0m\u001b[1;32m✅ PREDICCIÓN: BAJO RIESGO\u001b[0m\u001b[32m                                                  \u001b[0m\u001b[32m \u001b[0m\u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m\u001b[32m \u001b[0m\u001b[32m                                                                            \u001b[0m\u001b[32m \u001b[0m\u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m\u001b[32m \u001b[0m\u001b[32mScore de Riesgo: \u001b[0m\u001b[32m23%\u001b[0m\u001b[32m                                                        \u001b[0m\u001b[32m \u001b[0m\u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m\u001b[32m \u001b[0m\u001b[32mConfianza: \u001b[0m\u001b[36m87%\u001b[0m\u001b[32m                                                              \u001b[0m\u001b[32m \u001b[0m\u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m\u001b[32m \u001b[0m\u001b[32m                                                                            \u001b[0m\u001b[32m \u001b[0m\u001b[32m│\u001b[0m\r\n\u001b[32m│\u001b[0m\u001b[32m \u001b[0m\u001b[2;32mPredicción realizada sin que "]
