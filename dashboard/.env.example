# Xcapit Privacy Dashboard - Environment Variables
# Copy this file to .env and configure the values

# =============================================================================
# API Configuration
# =============================================================================

# API Base URL (optional - defaults to /api/v1/consortiums for development)
# In production, set this to your deployed API URL
# VITE_API_URL=https://api.privacy.xcapit.com/api/v1

# API Key for authenticated requests (optional for development)
# VITE_API_KEY=your-api-key-here

# =============================================================================
# Blockchain Configuration (Optional)
# =============================================================================

# Arbitrum RPC URL
# VITE_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Contract Addresses (set after deployment)
# VITE_MODEL_REGISTRY_ADDRESS=0x...
# VITE_COMPUTATION_VERIFIER_ADDRESS=0x...
# VITE_CONSORTIUM_GOVERNANCE_ADDRESS=0x...

# Chain ID (Arbitrum One: 42161, Arbitrum Sepolia: 421614)
# VITE_CHAIN_ID=421614

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/disable blockchain features
# VITE_ENABLE_BLOCKCHAIN=true

# Enable/disable FHE encryption features
# VITE_ENABLE_FHE=true

# Enable/disable compliance features
# VITE_ENABLE_COMPLIANCE=true

# Enable/disable governance features
# VITE_ENABLE_GOVERNANCE=true

# =============================================================================
# Analytics & Monitoring (Optional)
# =============================================================================

# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# =============================================================================
# Internationalization
# =============================================================================

# Default language (en | es)
VITE_DEFAULT_LANGUAGE=en

# =============================================================================
# Development Settings
# =============================================================================

# Enable debug mode (shows additional logs)
# VITE_DEBUG=true

# Mock API responses for development
# VITE_MOCK_API=false
