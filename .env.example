# Xcapit FHE-ML Platform - Docker Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to version control
#
# Generate secrets with: openssl rand -hex 32

# =============================================================================
# REQUIRED - Django
# =============================================================================

DJANGO_SECRET_KEY=generate-a-strong-secret-key-min-50-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,apifhe.xcapit.com

# =============================================================================
# REQUIRED - PostgreSQL
# =============================================================================

POSTGRES_USER=xcapit
POSTGRES_PASSWORD=generate-a-strong-password-here
POSTGRES_DB=fheml

# =============================================================================
# OPTIONAL - Redis (leave empty for no password in dev)
# =============================================================================

REDIS_PASSWORD=

# =============================================================================
# OPTIONAL - Security
# =============================================================================

# Separate JWT signing key (recommended for production)
JWT_SIGNING_KEY=

# CORS origins (comma-separated)
CORS_ALLOWED_ORIGINS=https://xcapit-privacy.vercel.app,https://app.xcapit.io

# CSRF trusted origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://apifhe.xcapit.com

# =============================================================================
# OPTIONAL - OpenBao / Vault (Secret Management)
# =============================================================================

# Enable vault integration (set to "true" to use vault for secrets)
VAULT_ENABLED=false

# OpenBao/Vault server address
BAO_ADDR=http://openbao:8200

# Authentication method 1: Token (development only)
BAO_TOKEN=

# Authentication method 2: AppRole (recommended for production)
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# KV secrets engine mount point
VAULT_MOUNT_POINT=xcapit

# =============================================================================
# OPTIONAL - Monitoring
# =============================================================================

SENTRY_DSN=
