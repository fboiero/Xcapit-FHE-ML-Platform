# ============================================
# Xcapit FHE API - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!

# ============ AWS Configuration ============
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# ============ ECR/ECS Configuration ============
ECR_REPO_NAME=xcapit-fhe-api
ECS_CLUSTER_NAME=xcapit-cluster
ECS_SERVICE_NAME=xcapit-fhe-api-service

# ============ Application Configuration ============
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# ============ Database ============
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/xcapit_fhe

# ============ Authentication ============
# JWT secret for token signing (generate with: openssl rand -hex 32)
JWT_SECRET=your-256-bit-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============ Blockchain (Arbitrum) ============
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# Or use Alchemy/Infura:
# ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/your-api-key

# Contract addresses (if deployed)
CONSORTIUM_CONTRACT_ADDRESS=0x...
MODEL_REGISTRY_CONTRACT_ADDRESS=0x...

# ============ Optional: FHE Configuration ============
# Security level for CKKS scheme (128, 192, or 256)
FHE_SECURITY_LEVEL=128

# ============ Optional: CORS ============
CORS_ORIGINS=https://appfhe.xcapit.com,https://localhost:5173

# ============ Optional: Rate Limiting ============
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
