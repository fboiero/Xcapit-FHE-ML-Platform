# Xcapit FHE-ML Platform - Deployment Environment Variables
# Copy this file to .env and fill in your values

# Deployer wallet private key (with 0x prefix)
# Must have Arbitrum Sepolia ETH for gas
# Get testnet ETH: https://faucet.quicknode.com/arbitrum/sepolia
DEPLOYER_PRIVATE_KEY=0x...

# Arbitrum Sepolia RPC URL
# Public RPC (rate limited): https://sepolia-rollup.arbitrum.io/rpc
# Or use Alchemy/Infura for better reliability
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Arbiscan API Key for contract verification
# Get one at: https://arbiscan.io/apis
ARBISCAN_API_KEY=...
